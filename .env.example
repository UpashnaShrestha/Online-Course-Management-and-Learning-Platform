# ---------------------------------------------------------------------------
# CourseFlow - environment template
# Copy to .env (or set these in your OS / IDE run configuration).
# NOTHING here has a working default: supply real values per environment.
# ---------------------------------------------------------------------------

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/ocmpl_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
SERVER_PORT=8080
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_SECRET_KEY=
KHALTI_RETURN_URL=http://localhost:5173/payment/khalti/callback
KHALTI_WEBSITE_URL=http://localhost:5173
JPA_SHOW_SQL=false
JPA_OPEN_IN_VIEW=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- JWT ---
# Generate with:  openssl rand -base64 64
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-random-64-byte-base64-secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_REMEMBER_ME_REFRESH_TOKEN_EXPIRATION=2592000000
npm run dev
# --- SMTP (password reset emails) ---
# Gmail: enable 2-Step Verification, then use an App Password (not your account password).
# Outlook: MAIL_HOST=smtp.office365.com, MAIL_PORT=587
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Supply your own App Password here. Never commit a real one.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Leave false. When true, an unreachable SMTP server stops the whole application from
# starting -- an email outage would take down login and every dashboard.
MAIL_TEST_CONNECTION=false

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:5173

# --- Password reset OTP ---
PASSWORD_RESET_OTP_LENGTH=6
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN=60

# --- Development only ---
# Returns the OTP in the API response so the flow works with no mail server.
# MUST be false anywhere real: it would let anyone reset any account by email.
PASSWORD_RESET_EXPOSE_OTP=false

# --- One-time bootstrap accounts (skipped if the username already exists) ---
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_INSTRUCTOR_USERNAME=
APP_BOOTSTRAP_INSTRUCTOR_PASSWORD=

# --- Uploads ---
# Where user-uploaded files (profile pictures) are written. Use an absolute path in
# production, e.g. UPLOAD_DIR=/var/lib/courseflow/uploads
UPLOAD_DIR=./uploads
# Largest profile image accepted. Phone photos are downscaled in the browser first, so
# this is a backstop rather than the usual limit.
UPLOAD_MAX_IMAGE_SIZE=5MB
FILE_STORAGE_BASE_PATH=./uploaded-files
FILE_STORAGE_MAX_FILE_SIZE_MB=5120